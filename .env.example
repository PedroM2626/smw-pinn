# Optional environment overrides for the SMW PINN suite.
#
# There is NO dotenv loader: these are ordinary shell variables read directly by
# src/utils/paths.py and src/utils/logging.py. Export them in your shell (or activate
# them from a virtualenv hook). Every value below is optional - unset means the
# repository default shown in the comment is used.
#
#   POSIX:   export SMW_ROM=/abs/path/to/smw_usa.sfc
#   PowerShell:  $env:SMW_ROM = "C:\path\to\smw_usa.sfc"
#
# The commercial ROM is never committed; supply your own dump (SHA-1 in the README).

# Absolute path to a *Super Mario World (USA)* ROM dump.
# Default: <repo>/data/raw/smw_usa.sfc
# SMW_ROM=/abs/path/to/smw_usa.sfc

# Libretro core to load (a suffix-less stem also works; the platform suffix is appended).
# Default: <repo>/src/environment/bin/snes9x_libretro.(dll|so|dylib)
# SMW_CORE=/abs/path/to/snes9x_libretro

# Where datasets and savestates live.
# Default: <repo>/data/raw
# SMW_DATA_DIR=/abs/path/to/data/raw

# Where results/ artifacts are written (metrics JSON, checkpoints, figures).
# Default: <repo>/results
# SMW_RESULTS_DIR=/abs/path/to/results

# Logging verbosity for the src.utils.logging helper.
# Default: INFO  (options: DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional experiment tracking. Leave unset to keep runs fully offline.
# Only `--wandb` entry points read this, and it is never logged into artifacts.
# WANDB_API_KEY=
