# Git-LFS tracking for large binaries and datasets.
# Setup: git lfs install
# Migrating an existing history (rewrites history - coordinate with the team):
#   git lfs migrate import --include="*.pt,*.pth,*.onnx,*.mp4,*.gif,*.npz,*.state,*.dll,*.zip,*.png"
#   git push --force
# New files matching the patterns below go to LFS automatically after `git lfs install`.

# PyTorch / ONNX checkpoints (results/checkpoints*, results/checkpoints_ensemble, etc.)
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
# Emulator datasets and savestates (data/raw/*.npz, *.state)
*.npz filter=lfs diff=lfs merge=lfs -text
*.state filter=lfs diff=lfs merge=lfs -text
*.bk2 filter=lfs diff=lfs merge=lfs -text
# Emulator core and archives (src/environment/bin/*)
*.dll filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# Result media (results/figures/*.mp4, *.gif, *.png)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
results/figures/*.png filter=lfs diff=lfs merge=lfs -text
# Commercial ROM patterns: kept here only so a locally supplied dump can never
# be committed by accident. New clones must provide their own dump and verify
# the SHA-1 published in the README.
*.sfc filter=lfs diff=lfs merge=lfs -text
*.smc filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
