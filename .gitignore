# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
ENV/

# PyTorch & Machine Learning
# NOTE: the versioned checkpoints/results are tracked through Git-LFS
# (see .gitattributes) and are deliberately NOT ignored here, so published
# numbers stay reproducible.
runs/
events.out.tfevents.*
wandb/
lightning_logs/
logs/
tensorboard_logs/
mlruns/

# Data, ROMs & Emulator binaries
# Datasets (.npz), savestates (.state/.bk2), checkpoints (.pt/.pth),
# videos (.mp4/.gif) and the emulator core (.dll/.zip) are versioned
# through Git-LFS - see .gitattributes; they are not ignored here.
# Commercial ROM: never committed. Each user supplies their own dump and
# checks the SHA-1 published in the README; local dumps stay untracked.
roms/
*.sfc
*.smc

# Jupyter & IDE
.ipynb_checkpoints
.pytest_cache/
.vscode/
.idea/

# Ad-hoc run logs from manual hardware captures (not part of the published results)
/*.log

# PySR writes a scratch run directory next to the CWD unless told otherwise.
outputs/

# Coverage & smoke-test artifacts (produced by `make test-cov` / `make reproduce`)
.coverage
coverage.xml
results_smoke*/
runs_smoke*/

# Distribution & Build
dist/
build/
*.egg-info/
